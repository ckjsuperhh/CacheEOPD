# Paths for the EOPD paper-scale Qwen3-8B -> Qwen3-1.7B experiment.
PROJECT_ROOT=/absolute/path/to/CacheEOPD
PYTHON_BIN=python

# Qwen3 models used by both EOPD and CacheEOPD.
STUDENT_PATH=/absolute/path/to/Qwen3-1.7B-Base
TEACHER_PATH=/absolute/path/to/Qwen3-8B

# Paper training data, produced by examples/data_preprocess/math_dataset.py.
TRAIN_FILE=/absolute/path/to/data/math/train.parquet
VAL_FILE=/absolute/path/to/data/math/test.parquet

# C2C OpenHermes projector corpus and the resulting frozen checkpoint.
PROJECTOR_DATA=/absolute/path/to/data/openhermes_c2c_projector.jsonl
PROJECTOR_OUT=/absolute/path/to/runs/projector_qwen3_8b_to_1p7b
PROJECTOR_PATH=/absolute/path/to/runs/projector_qwen3_8b_to_1p7b/projector_final.pt

# Storage and GPU layout. Keep the same layout for both baseline arms.
OUTPUT_ROOT=/absolute/path/to/runs/eopd_cacheeopd
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
NGPU=8
ROLLOUT_TP=1
ROLLOUT_DP=8

# EOPD paper protocol.
MAX_PROMPT=2048
MAX_RESPONSE=8192
MAX_MODEL_LEN=10240
MAX_BATCHED_TOKENS=32768
TRAIN_BATCH_SIZE=128
MINI_BATCH_SIZE=32
MICRO_BATCH_SIZE=1
TOPK_LOGITS=16
ENTROPY_THRESHOLD=0.8
SOFT_KD_COEF=1.0
TOTAL_EPOCHS=3
TOTAL_STEPS=
LR=1e-6
TRAIN_TEMPERATURE=1.0
TRAIN_TOP_P=0.8
GPU_MEMORY_UTILIZATION=0.70
SAVE_FREQ=50
TEST_FREQ=50

# Projector training uses one student GPU and the remaining listed GPUs for the teacher.
PROJECTOR_DEVICE=cuda:0
PROJECTOR_TEACHER_DEVICE=auto
PROJECTOR_TEACHER_GPUS=1,2,3,4,5,6,7
PROJECTOR_STEPS=15000
PROJECTOR_SAVE_EVERY=500
PROJECTOR_EVAL_EVERY=100
PROJECTOR_HOLDOUT=5000
PROJECTOR_MAX_PROMPT=2048
PROJECTOR_MAX_ANSWER=8192
PROJECTOR_LR=1e-4
PROJECTOR_GRAD_ACCUM=8
PROJECTOR_SEED=42
