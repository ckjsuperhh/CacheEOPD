# Copy this file to .env and fill in paths for the VM.
PROJECT_ROOT=/absolute/path/to/CacheEOPD
PYTHON_BIN=python
STUDENT=/absolute/path/to/Qwen3-0.6B
TEACHER=/absolute/path/to/Qwen3-4B
FUSER_DIR=/absolute/path/to/qwen3_0.6b+qwen3_4b_base_Fuser/final
TRAJECTORY=/absolute/path/to/teacher_traj_gsm8k1500.jsonl
EVAL_DATA=/absolute/path/to/gsm8k_cot_test_500.jsonl
DEVICE=cuda:0
TEACHER_GPUS=0
PROJ_DEVICE=cuda:0
OUT_ROOT=/absolute/path/to/cacheeopd_runs
MAX_PROMPT_LEN=384
MAX_NEW_TOKENS=384
STEPS=300
LR=1e-6
SAVE_EVERY=50
TOPK=16
ENTROPY_THRESHOLD=0.8
SOFT_KD_COEF=1.0
CLIP_RATIO=0.2
