# ============================================================================
# Docker 镜像: verl 稳定版 SGLang 推理环境
# ============================================================================
# 用途: 构建基于 SGLang 的 verl 稳定版推理+训练镜像
# 基础镜像: lmsysorg/sglang:v0.5.6.post2 (SGLang 官方镜像)
# 主要安装内容:
#   - NVIDIA Apex (混合精度训练)
#   - NVIDIA TransformerEngine v2.10 (Transformer 加速引擎)
#   - Flash-Attention 2.8.1 (高效注意力机制)
#   - Nsight Systems 2025.6.1 (性能分析工具)
#   - Megatron-LM core_v0.15.0 (大模型分布式训练)
#   - mbridge (模型桥接工具)
#   - verl v0.6.0 (仅获取依赖，安装后卸载)
#   - DeepEP (SGLang 镜像已内置)
# 注意: cuDNN 版本需要与 PyTorch 2.9.1 兼容
# ============================================================================

# 基于 SGLang 官方镜像 v0.5.6.post2
FROM lmsysorg/sglang:v0.5.6.post2

ARG PIP_NO_CACHE_DIR=1

# 安装 pybind11 (C++/Python 绑定库)
RUN pip install pybind11

# 安装 nvidia-mathdx (NVIDIA 数学扩展库)
RUN pip install nvidia-mathdx

# 安装 NVIDIA Apex (混合精度训练、Fused Adam 等优化器)
RUN MAX_JOBS=128 pip install -v --disable-pip-version-check --no-cache-dir --no-build-isolation --config-settings "--build-option=--cpp_ext" --config-settings "--build-option=--cuda_ext" git+https://github.com/NVIDIA/apex.git

# 安装 NVIDIA TransformerEngine v2.10 (Transformer 模型加速引擎，支持 FP8 等)
RUN export NVTE_FRAMEWORK=pytorch && MAX_JOBS=128 NVTE_BUILD_THREADS_PER_JOB=4 pip3 install --resume-retries 999 --no-cache-dir --no-build-isolation git+https://github.com/NVIDIA/TransformerEngine.git@release_v2.10

# 升级 transformers 和 tokenizers 到最新版本
RUN pip install --upgrade --no-cache-dir transformers tokenizers

# 安装辅助工具包：codetiming (计时)、tensordict (张量字典)、mathruler (数学评估) 等
RUN pip install codetiming tensordict mathruler pylatexenc qwen_vl_utils

# 安装 Flash-Attention 2.8.1 (不隔离构建，直接使用系统 CUDA)
RUN pip install --no-cache-dir --no-build-isolation flash_attn==2.8.1

# 安装 Nsight Systems 2025.6.1 性能分析工具 (nsys)
RUN NSIGHT_VERSION=2025.6.1_2025.6.1.190-1_$(if [ "$(uname -m)" = "aarch64" ]; then echo "arm64"; else echo "amd64"; fi) && \
    wget https://developer.nvidia.com/downloads/assets/tools/secure/nsight-systems/2025_6/nsight-systems-${NSIGHT_VERSION}.deb && \
    apt-get update && apt-get install -y libxcb-cursor0 && \
    apt-get install -y ./nsight-systems-${NSIGHT_VERSION}.deb && \
    rm -rf /usr/local/cuda/bin/nsys && \
    ln -s /opt/nvidia/nsight-systems/2025.6.1/nsys  /usr/local/cuda/bin/nsys && \
    rm -rf /usr/local/cuda/bin/nsys-ui && \
    ln -s /opt/nvidia/nsight-systems/2025.6.1/nsys-ui /usr/local/cuda/bin/nsys-ui && \
    rm nsight-systems-${NSIGHT_VERSION}.deb

# sglang 镜像已内置 DeepEP（DeepSeek Expert Parallel 通信库）
# sglang image has already installed DeepEP

# 安装 trl (Transformer Reinforcement Learning，无依赖安装避免冲突)
RUN pip3 install --no-cache-dir --no-deps trl

# 安装 nvtx (NVIDIA 标注工具)、matplotlib (可视化)、liger_kernel (高效内核)
RUN pip3 install nvtx matplotlib liger_kernel

# 安装 mbridge (模型参数桥接工具，用于跨框架权重转换)
RUN pip install -U git+https://github.com/ISEEKYAN/mbridge.git

# 安装 Megatron-LM core_v0.15.0 (NVIDIA 大模型分布式训练框架，无依赖安装)
RUN pip install --no-deps --no-cache-dir git+https://github.com/NVIDIA/Megatron-LM.git@core_v0.15.0

# 克隆 verl v0.6.0 以获取依赖列表，安装后卸载 verl 本身（运行时从源码安装）
RUN pip install git+https://github.com/volcengine/verl.git@v0.6.0 && \
    pip uninstall -y verl

# 修复 cuDNN 9.10 与 PyTorch 2.9.1 的兼容性 bug：移除 METADATA 中的 cudnn 依赖声明
# avoid cudnn9.10&torch2.9.1 bug
RUN sed -i '/nvidia-cudnn-cu12/d' /usr/local/lib/python3.12/dist-packages/torch-2.9.1+cu129.dist-info/METADATA
# 强制重新安装兼容版本的 cuDNN
RUN pip install --no-deps --force-reinstall nvidia-cudnn-cu12==9.16.0.29
